<Window x:Class="UtilityWPF.MainWindow"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        Title="AMS Utility Browser"

        Width="1000"

        Height="760"

        MinWidth="900"

        MinHeight="650"

        WindowStartupLocation="CenterScreen"

        Background="#F7F8FA"

        FontFamily="Segoe UI"

        FontSize="13">


    <Window.Resources>


        <!-- ===================================================== -->
        <!-- MODERN BUTTON STYLES                                  -->
        <!-- ===================================================== -->

        <Style x:Key="PrimaryButton"
               TargetType="Button">

            <Setter Property="Background"
                    Value="#2563EB"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Padding"
                    Value="15,7"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"

                                CornerRadius="6"

                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter

                                HorizontalAlignment="Center"

                                VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#1D4ED8"/>

                </Trigger>

            </Style.Triggers>

        </Style>


        <Style x:Key="SecondaryButton"
               TargetType="Button">

            <Setter Property="Background"
                    Value="#FFFFFF"/>

            <Setter Property="Foreground"
                    Value="#374151"/>

            <Setter Property="BorderBrush"
                    Value="#D1D5DB"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Padding"
                    Value="15,7"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"

                                BorderBrush="{TemplateBinding BorderBrush}"

                                BorderThickness="{TemplateBinding BorderThickness}"

                                CornerRadius="6"

                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter

                                HorizontalAlignment="Center"

                                VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#F3F4F6"/>

                </Trigger>

            </Style.Triggers>

        </Style>


        <Style x:Key="ViewButton"
               TargetType="Button">

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="Foreground"
                    Value="#2563EB"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Padding"
                    Value="12,6"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

        </Style>


        <!-- ===================================================== -->
        <!-- CHECKLIST ROW STYLE                                   -->
        <!-- ===================================================== -->

        <Style x:Key="ChecklistRow"
               TargetType="Border">

            <Setter Property="Background"
                    Value="#FFFFFF"/>

            <Setter Property="BorderBrush"
                    Value="#E5E7EB"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="CornerRadius"
                    Value="8"/>

            <Setter Property="Margin"
                    Value="0,0,0,8"/>

            <Setter Property="Padding"
                    Value="16,10"/>

        </Style>


    </Window.Resources>


    <Grid>


        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>


        <!-- ===================================================== -->
        <!-- HEADER                                                -->
        <!-- ===================================================== -->

        <Border Grid.Row="0"

                Background="#FFFFFF"

                BorderBrush="#E5E7EB"

                BorderThickness="0,0,0,1"

                Padding="30,22">

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>


                <StackPanel>

                    <TextBlock Text="AMS Utility Browser"

                               FontSize="23"

                               FontWeight="SemiBold"

                               Foreground="#1F2937"/>

                    <TextBlock Text="Print release utilities"

                               FontSize="13"

                               Foreground="#6B7280"

                               Margin="0,4,0,0"/>

                </StackPanel>


                <Border Grid.Column="1"

                        Background="#EFF6FF"

                        CornerRadius="6"

                        Padding="12,7"

                        VerticalAlignment="Center">

                    <StackPanel Orientation="Horizontal">

                        <Ellipse Width="7"

                                 Height="7"

                                 Fill="#2563EB"

                                 VerticalAlignment="Center"

                                 Margin="0,0,7,0"/>

                        <TextBlock Text="Ready"

                                   Foreground="#1D4ED8"

                                   FontWeight="SemiBold"/>

                    </StackPanel>

                </Border>

            </Grid>

        </Border>


        <ScrollViewer Grid.Row="1"

                      VerticalScrollBarVisibility="Auto">

            <StackPanel Margin="30,24,30,24">


                <!-- ===================================================== -->
                <!-- ACTIVE PROJECT                                        -->
                <!-- ===================================================== -->

                <Border Background="#FFFFFF"

                        BorderBrush="#E2E5E9"

                        BorderThickness="1"

                        CornerRadius="10"

                        Padding="22"

                        Margin="0,0,0,24">

                    <StackPanel>


                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="Auto"/>

                            </Grid.ColumnDefinitions>


                            <StackPanel>

                                <TextBlock Text="ACTIVE PROJECT"

                                           FontSize="15"

                                           FontWeight="SemiBold"

                                           Foreground="#1F2937"/>

                                <TextBlock Text="The active AutoCAD Electrical project loads automatically."

                                           Foreground="#6B7280"

                                           Margin="0,5,0,0"/>

                            </StackPanel>


                            <Button Grid.Column="1"

                                    Content="Select Project"

                                    Style="{StaticResource SecondaryButton}"

                                    Command="{Binding SelectProjectCommand}"

                                    VerticalAlignment="Center"/>

                        </Grid>


                        <Border Background="#F9FAFB"

                                BorderBrush="#E5E7EB"

                                BorderThickness="1"

                                CornerRadius="7"

                                Margin="0,18,0,0"

                                Padding="16">

                            <Grid>


                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="150"/>

                                    <ColumnDefinition Width="*"/>

                                </Grid.ColumnDefinitions>


                                <Grid.RowDefinitions>

                                    <RowDefinition Height="Auto"/>

                                    <RowDefinition Height="Auto"/>

                                    <RowDefinition Height="Auto"/>

                                </Grid.RowDefinitions>


                                <TextBlock Grid.Row="0"

                                           Grid.Column="0"

                                           Text="Project Name"

                                           Foreground="#6B7280"

                                           Margin="0,0,0,10"/>


                                <TextBlock Grid.Row="0"

                                           Grid.Column="1"

                                           Text="{Binding ProjectName}"

                                           FontWeight="SemiBold"

                                           Foreground="#1F2937"

                                           Margin="0,0,0,10"/>


                                <TextBlock Grid.Row="1"

                                           Grid.Column="0"

                                           Text="Project Path"

                                           Foreground="#6B7280"

                                           Margin="0,0,0,10"/>


                                <TextBlock Grid.Row="1"

                                           Grid.Column="1"

                                           Text="{Binding ProjectPath}"

                                           Foreground="#374151"

                                           TextTrimming="CharacterEllipsis"

                                           Margin="0,0,0,10"/>


                                <TextBlock Grid.Row="2"

                                           Grid.Column="0"

                                           Text="Last Updated"

                                           Foreground="#6B7280"/>


                                <TextBlock Grid.Row="2"

                                           Grid.Column="1"

                                           Text="{Binding LastUpdated}"

                                           Foreground="#374151"/>

                            </Grid>

                        </Border>

                    </StackPanel>

                </Border>


                <!-- ===================================================== -->
                <!-- PRINT RELEASE CHECKLIST                               -->
                <!-- ===================================================== -->

                <Grid Margin="2,0,2,14">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>


                    <StackPanel>

                        <TextBlock Text="PRINT RELEASE CHECKLIST"

                                   FontSize="15"

                                   FontWeight="SemiBold"

                                   Foreground="#1F2937"/>

                        <TextBlock Text="Work from top to bottom through the print release checklist."

                                   Foreground="#6B7280"

                                   Margin="0,5,0,0"/>

                    </StackPanel>


                    <Border Grid.Column="1"

                            Background="#F3F4F6"

                            CornerRadius="5"

                            Padding="10,5"

                            VerticalAlignment="Center">

                        <TextBlock Text="9 Steps"

                                   Foreground="#4B5563"

                                   FontWeight="SemiBold"/>

                    </Border>

                </Grid>


                <!-- ===================================================== -->
                <!-- CHECKLIST                                             -->
                <!-- ===================================================== -->

                <StackPanel>


                    <!--==============================================================================================-->
                    <!--=============         1. Check Drawing Filenames               ===============================-->
                    <!--==============================================================================================-->

                    <Border Style="{StaticResource ChecklistRow}">

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="44"/>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="130"/>

                                <ColumnDefinition Width="Auto"/>

                            </Grid.ColumnDefinitions>


                            <Border Width="30"

                                    Height="30"

                                    Background="#EFF6FF"

                                    CornerRadius="15"

                                    VerticalAlignment="Center">

                                <TextBlock Text="1"

                                           Foreground="#2563EB"

                                           FontWeight="SemiBold"

                                           HorizontalAlignment="Center"

                                           VerticalAlignment="Center"/>

                            </Border>


                            <StackPanel Grid.Column="1"

                                        VerticalAlignment="Center">

                                <TextBlock Text="Check Drawing Filenames"

                                           FontWeight="SemiBold"

                                           Foreground="#1F2937"/>

                                <TextBlock Text="{Binding DrawingFilenameStatus}"

                                           Foreground="#6B7280"

                                           Margin="0,2,0,0"/>

                            </StackPanel>


                            <Button Grid.Column="2"

                                    Content="View"

                                    Style="{StaticResource ViewButton}"

                                    Command="{Binding ViewDrawingFilenamesCommand}"

                                    HorizontalAlignment="Right"

                                    VerticalAlignment="Center"/>


                            <Button Grid.Column="3"

                                    Content="Run"

                                    Width="70"

                                    Style="{StaticResource PrimaryButton}"

                                    Command="{Binding CheckDrawingFilenamesCommand}"

                                    Margin="8,0,0,0"/>

                        </Grid>

                    </Border>


                    <!--==============================================================================================-->
                    <!--=============         2. Update Drawing Properties             ===============================-->
                    <!--==============================================================================================-->

                    <Border Style="{StaticResource ChecklistRow}">

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="44"/>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="130"/>

                                <ColumnDefinition Width="Auto"/>

                            </Grid.ColumnDefinitions>


                            <Border Width="30"

                                    Height="30"

                                    Background="#EFF6FF"

                                    CornerRadius="15">

                                <TextBlock Text="2"

                                           Foreground="#2563EB"

                                           FontWeight="SemiBold"

                                           HorizontalAlignment="Center"

                                           VerticalAlignment="Center"/>

                            </Border>


                            <StackPanel Grid.Column="1"

                                        VerticalAlignment="Center">

                                <TextBlock Text="Update Drawing Properties"

                                           FontWeight="SemiBold"

                                           Foreground="#1F2937"/>

                                <TextBlock Text="{Binding DrawingPropertiesStatus}"

                                           Foreground="#6B7280"

                                           Margin="0,2,0,0"/>

                            </StackPanel>


                            <Button Grid.Column="2"

                                    Content="View"

                                    Style="{StaticResource ViewButton}"

                                    Command="{Binding ViewDrawingPropertiesCommand}"

                                    HorizontalAlignment="Right"

                                    VerticalAlignment="Center"/>


                            <Button Grid.Column="3"

                                    Content="Run"

                                    Width="70"

                                    Style="{StaticResource PrimaryButton}"

                                    Command="{Binding UpdateDrawingPropertiesCommand}"

                                    Margin="8,0,0,0"/>

                        </Grid>

                    </Border>


                    <!--==============================================================================================-->
                    <!--=============         3. Update Title Blocks====               ===============================-->
                    <!--==============================================================================================-->

                    <Border Style="{StaticResource ChecklistRow}">

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="44"/>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="130"/>

                                <ColumnDefinition Width="Auto"/>

                            </Grid.ColumnDefinitions>


                            <Border Width="30"

                                    Height="30"

                                    Background="#EFF6FF"

                                    CornerRadius="15">

                                <TextBlock Text="3"

                                           Foreground="#2563EB"

                                           FontWeight="SemiBold"

                                           HorizontalAlignment="Center"

                                           VerticalAlignment="Center"/>

                            </Border>


                            <StackPanel Grid.Column="1"

                                        VerticalAlignment="Center">

                                <TextBlock Text="Update Title Blocks"

                                           FontWeight="SemiBold"

                                           Foreground="#1F2937"/>

                                <TextBlock Text="{Binding TitleBlockUpdateStatus}"

                                           Foreground="#6B7280"

                                           Margin="0,2,0,0"/>

                            </StackPanel>


                            <Button Grid.Column="2"

                                    Content="View"

                                    Style="{StaticResource ViewButton}"

                                    Command="{Binding ViewTitleBlocksCommand}"

                                    HorizontalAlignment="Right"

                                    VerticalAlignment="Center"/>


                            <Button Grid.Column="3"

                                    Content="Run"

                                    Width="70"

                                    Style="{StaticResource PrimaryButton}"

                                    Command="{Binding UpdateTitleBlocksCommand}"

                                    Margin="8,0,0,0"/>

                        </Grid>

                    </Border>


                    <!--==============================================================================================-->
                    <!--=============         4. Check Project and Drawing Properties        =========================-->
                    <!--==============================================================================================-->

                    <Border Style="{StaticResource ChecklistRow}">

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="44"/>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="130"/>

                                <ColumnDefinition Width="Auto"/>

                            </Grid.ColumnDefinitions>


                            <Border Width="30"

                                    Height="30"

                                    Background="#EFF6FF"

                                    CornerRadius="15">

                                <TextBlock Text="4"

                                           Foreground="#2563EB"

                                           FontWeight="SemiBold"

                                           HorizontalAlignment="Center"

                                           VerticalAlignment="Center"/>

                            </Border>


                            <StackPanel Grid.Column="1"

                                        VerticalAlignment="Center">

                                <TextBlock Text="Check Project and Drawing Properties"

                                           FontWeight="SemiBold"

                                           Foreground="#1F2937"/>

                                <TextBlock Text="{Binding ProjectDrawingPropertiesStatus}"

                                           Foreground="#6B7280"

                                           Margin="0,2,0,0"/>

                            </StackPanel>


                            <Button Grid.Column="2"

                                    Content="View"

                                    Style="{StaticResource ViewButton}"

                                    Command="{Binding ViewProjectDrawingPropertiesCommand}"

                                    HorizontalAlignment="Right"

                                    VerticalAlignment="Center"/>


                            <Button Grid.Column="3"

                                    Content="Run"

                                    Width="70"

                                    Style="{StaticResource PrimaryButton}"

                                    Command="{Binding CheckProjectDrawingPropertiesCommand}"

                                    Margin="8,0,0,0"/>

                        </Grid>

                    </Border>


                    <!--==============================================================================================-->
                    <!--=============         5. Check Title Blocks=======             ===============================-->
                    <!--==============================================================================================-->

                    <Border Style="{StaticResource ChecklistRow}">

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="44"/>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="130"/>

                                <ColumnDefinition Width="Auto"/>

                            </Grid.ColumnDefinitions>


                            <Border Width="30"

                                    Height="30"

                                    Background="#EFF6FF"

                                    CornerRadius="15">

                                <TextBlock Text="5"

                                           Foreground="#2563EB"

                                           FontWeight="SemiBold"

                                           HorizontalAlignment="Center"

                                           VerticalAlignment="Center"/>

                            </Border>


                            <StackPanel Grid.Column="1"

                                        VerticalAlignment="Center">

                                <TextBlock Text="Check Title Blocks"

                                           FontWeight="SemiBold"

                                           Foreground="#1F2937"/>

                                <TextBlock Text="{Binding TitleBlockCheckStatus}"

                                           Foreground="#6B7280"

                                           Margin="0,2,0,0"/>

                            </StackPanel>


                            <Button Grid.Column="2"

                                    Content="View"

                                    Style="{StaticResource ViewButton}"

                                    Command="{Binding ViewTitleBlocksCommand}"

                                    HorizontalAlignment="Right"

                                    VerticalAlignment="Center"/>


                            <Button Grid.Column="3"

                                    Content="Run"

                                    Width="70"

                                    Style="{StaticResource PrimaryButton}"

                                    Command="{Binding CheckTitleBlocksCommand}"

                                    Margin="8,0,0,0"/>

                        </Grid>

                    </Border>


                    <!--==============================================================================================-->
                    <!--=============         6. Check Drawing Health===               ===============================-->
                    <!--==============================================================================================-->

                    <Border Style="{StaticResource ChecklistRow}">

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="44"/>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="130"/>

                                <ColumnDefinition Width="Auto"/>

                            </Grid.ColumnDefinitions>


                            <Border Width="30"

                                    Height="30"

                                    Background="#EFF6FF"

                                    CornerRadius="15">

                                <TextBlock Text="6"

                                           Foreground="#2563EB"

                                           FontWeight="SemiBold"

                                           HorizontalAlignment="Center"

                                           VerticalAlignment="Center"/>

                            </Border>


                            <StackPanel Grid.Column="1"

                                        VerticalAlignment="Center">

                                <TextBlock Text="Check Drawing Health"

                                           FontWeight="SemiBold"

                                           Foreground="#1F2937"/>

                                <TextBlock Text="{Binding DrawingHealthStatus}"

                                           Foreground="#6B7280"

                                           Margin="0,2,0,0"/>

                            </StackPanel>


                            <Button Grid.Column="3"

                                    Content="Run"

                                    Width="70"

                                    Style="{StaticResource PrimaryButton}"

                                    Command="{Binding CheckDrawingHealthCommand}"

                                    Margin="8,0,0,0"/>

                        </Grid>

                    </Border>


                    <!--==============================================================================================-->
                    <!--=============         7. Check Component Attributes              =============================-->
                    <!--==============================================================================================-->

                    <Border Style="{StaticResource ChecklistRow}">

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="44"/>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="130"/>

                                <ColumnDefinition Width="Auto"/>

                            </Grid.ColumnDefinitions>


                            <Border Width="30"

                                    Height="30"

                                    Background="#EFF6FF"

                                    CornerRadius="15">

                                <TextBlock Text="7"

                                           Foreground="#2563EB"

                                           FontWeight="SemiBold"

                                           HorizontalAlignment="Center"

                                           VerticalAlignment="Center"/>

                            </Border>


                            <StackPanel Grid.Column="1"

                                        VerticalAlignment="Center">

                                <TextBlock Text="Check Component Attributes"

                                           FontWeight="SemiBold"

                                           Foreground="#1F2937"/>

                                <TextBlock Text="{Binding ComponentAttributesStatus}"

                                           Foreground="#6B7280"

                                           Margin="0,2,0,0"/>

                            </StackPanel>


                            <Button Grid.Column="3"

                                    Content="Run"

                                    Width="70"

                                    Style="{StaticResource PrimaryButton}"

                                    Command="{Binding CheckComponentAttributesCommand}"

                                    Margin="8,0,0,0"/>

                        </Grid>

                    </Border>


                    <!--==============================================================================================-->
                    <!--=============         8. Check Catalog Assignments             ===============================-->
                    <!--==============================================================================================-->

                    <Border Style="{StaticResource ChecklistRow}">

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="44"/>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="130"/>

                                <ColumnDefinition Width="Auto"/>

                            </Grid.ColumnDefinitions>


                            <Border Width="30"

                                    Height="30"

                                    Background="#EFF6FF"

                                    CornerRadius="15">

                                <TextBlock Text="8"

                                           Foreground="#2563EB"

                                           FontWeight="SemiBold"

                                           HorizontalAlignment="Center"

                                           VerticalAlignment="Center"/>

                            </Border>


                            <StackPanel Grid.Column="1"

                                        VerticalAlignment="Center">

                                <TextBlock Text="Check Catalog Assignments"

                                           FontWeight="SemiBold"

                                           Foreground="#1F2937"/>

                                <TextBlock Text="{Binding CatalogAssignmentsStatus}"

                                           Foreground="#6B7280"

                                           Margin="0,2,0,0"/>

                            </StackPanel>


                            <Button Grid.Column="3"

                                    Content="Run"

                                    Width="70"

                                    Style="{StaticResource PrimaryButton}"

                                    Command="{Binding CheckCatalogAssignmentsCommand}"

                                    Margin="8,0,0,0"/>

                        </Grid>

                    </Border>


                    <!--==============================================================================================-->
                    <!--=============         9. Zoom to Extents                       ===============================-->
                    <!--==============================================================================================-->

                    <Border Style="{StaticResource ChecklistRow}">

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="44"/>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="130"/>

                                <ColumnDefinition Width="Auto"/>

                            </Grid.ColumnDefinitions>


                            <Border Width="30"

                                    Height="30"

                                    Background="#EFF6FF"

                                    CornerRadius="15">

                                <TextBlock Text="9"

                                           Foreground="#2563EB"

                                           FontWeight="SemiBold"

                                           HorizontalAlignment="Center"

                                           VerticalAlignment="Center"/>

                            </Border>


                            <StackPanel Grid.Column="1"

                                        VerticalAlignment="Center">

                                <TextBlock Text="Zoom to Extents"

                                           FontWeight="SemiBold"

                                           Foreground="#1F2937"/>

                                <TextBlock Text="{Binding ZoomToExtentsStatus}"

                                           Foreground="#6B7280"

                                           Margin="0,2,0,0"/>

                            </StackPanel>


                            <Button Grid.Column="2"

                                    Content="Default"

                                    Style="{StaticResource ViewButton}"

                                    Command="{Binding ZoomToExtentsDefaultCommand}"

                                    HorizontalAlignment="Right"

                                    VerticalAlignment="Center"/>


                            <Button Grid.Column="3"

                                    Content="Run"

                                    Width="70"

                                    Style="{StaticResource PrimaryButton}"

                                    Command="{Binding ZoomToExtentsCommand}"

                                    Margin="8,0,0,0"/>

                        </Grid>

                    </Border>


                </StackPanel>

            </StackPanel>

        </ScrollViewer>


        <!-- ===================================================== -->
        <!-- =========     BOTTOM BUTTONS             ============ -->
        <!-- ===================================================== -->

        <Border Grid.Row="2"

                Background="#FFFFFF"

                BorderBrush="#E5E7EB"

                BorderThickness="0,1,0,0"

                Padding="30,13">

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="Auto"/>

                    <ColumnDefinition Width="Auto"/>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>


                <Button Grid.Column="0"

                        Content="Help"

                        Style="{StaticResource ViewButton}"

                        Command="{Binding HelpCommand}"/>


                <Button Grid.Column="1"

                        Content="Reset Checklist"

                        Style="{StaticResource ViewButton}"

                        Command="{Binding ResetChecklistCommand}"

                        Margin="8,0,0,0"/>


                <Button Grid.Column="3"

                        Content="Close"

                        Width="75"

                        Style="{StaticResource SecondaryButton}"

                        Command="{Binding CloseCommand}"/>

            </Grid>

        </Border>

    </Grid>

</Window>
